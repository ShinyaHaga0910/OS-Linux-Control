...@theme

direction: right

local: 接続元\nローカル {
  class: boundary
  file: notes.txt { class: key }
  received: report.txt { class: key }
}

remote: 接続先\nリモート {
  class: boundary
  uploaded: ~/notes.txt { class: key }
  file: ~/report.txt { class: key }
}

local.file -> remote.uploaded: アップロード
remote.file -> local.received: ダウンロード
