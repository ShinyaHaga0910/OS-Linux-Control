...@theme

direction: right

configuration: 保存された設定 {
  class: boundary
  grid-rows: 2
  unit: unitファイル\n起動方法の設定 { class: neutral }
  enabled: enabled\n次回起動時に開始する設定 { class: identity }
  unit -> enabled
}

systemd: systemd\nPID 1 { class: os }

runtime: 現在の実行状態 {
  class: boundary
  grid-rows: 3
  process: サービスプロセス { class: app }
  active: active\n現在動いている状態 { class: app }
  kernel: カーネル資源\nCPU・メモリ・ファイル・通信 { class: hardware }
  process -> active
  process -> kernel
}

configuration.unit -> systemd
systemd -> runtime.process
