classes: {
  base: {
    style.fill: "#FFFFFF"
    style.stroke: "#173B65"
    style.stroke-width: 2
    style.border-radius: 12
    style.shadow: false
    style.font-size: 24
    style.font-color: "#172033"
  }
  os: {
    style.fill: "#E8F1FF"
    style.stroke: "#2563A6"
    style.stroke-width: 2
    style.border-radius: 12
  }
  app: {
    style.fill: "#E5F5EA"
    style.stroke: "#23834D"
    style.stroke-width: 2
    style.border-radius: 12
  }
  hardware: {
    style.fill: "#FFF0D6"
    style.stroke: "#B66516"
    style.stroke-width: 2
    style.border-radius: 12
  }
  identity: {
    style.fill: "#F0E8FF"
    style.stroke: "#6941A5"
    style.stroke-width: 2
    style.border-radius: 12
  }
  neutral: {
    style.fill: "#F2F4F7"
    style.stroke: "#657187"
    style.stroke-width: 2
    style.border-radius: 12
  }
  warning: {
    style.fill: "#FFE9E9"
    style.stroke: "#B33A3A"
    style.stroke-width: 2
    style.border-radius: 12
  }
  boundary: {
    style.fill: "#FAFBFD"
    style.stroke: "#173B65"
    style.stroke-width: 3
    style.border-radius: 16
    style.font-size: 26
    style.bold: true
  }
  key: {
    style.fill: "#FFFFFF"
    style.stroke: "#173B65"
    style.stroke-width: 2
    style.border-radius: 6
    style.font: mono
    style.font-size: 22
  }
}

***.style.font-size: 24
***.style.font-color: "#172033"
***.style.shadow: false
***.style.border-radius: 10

(* -> *)[*].style.stroke: "#314B6E"
(* -> *)[*].style.stroke-width: 2
(* -> *)[*].style.font-size: 19
(* -> *)[*].style.font-color: "#314B6E"
(* -> *)[*].style.border-radius: 8

style.fill: "#FFFFFF"
