#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  printf '%s\n' 'Usage: jdu-reset P0|P1|P2|P3|P4|P5|P6|M1|M2|M3|M4|M5|M6|M7|all'
}

if [[ "${1:-}" == reset ]]; then
  requested_mission="${2:-}"
else
  requested_mission="${1:-}"
fi
if [[ -z "$requested_mission" ]]; then
  usage >&2
  exit 2
fi

if ((EUID != 0)) && [[ "$(id -un)" != ssm-user ]]; then
  printf 'ERROR jdu-reset must be run as ssm-user, not %s. Run exit until id -un prints ssm-user.\n' "$(id -un)" >&2
  exit 2
fi

if ((EUID != 0)); then
  exec sudo -n -- "$0" "$@"
fi

mission="${requested_mission^^}"
[[ "$mission" == M0 ]] && mission=P0
student_user="${JDU_STUDENT_USER:-${SUDO_USER:-ssm-user}}"
if [[ "$student_user" == root ]] || ! getent passwd "$student_user" >/dev/null; then
  student_user=ssm-user
fi
student_home="$(getent passwd "$student_user" | awk -F: '{print $6}')"
student_group="$(id -gn "$student_user")"
workspace="$student_home/jdu-lab"

case "$workspace" in
  /home/*/jdu-lab) ;;
  *) printf 'ERROR Unsafe student workspace: %s\n' "$workspace" >&2; exit 2 ;;
esac

prepare_home_directory() {
  local mission_id="$1"
  local directory="$workspace/${mission_id,,}"
  install -d -o "$student_user" -g "$student_group" -m 0750 "$directory"
  find "$directory" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
}

ensure_account() {
  local user_name="$1" shell_name="${2:-/usr/sbin/nologin}"
  if ! getent passwd "$user_name" >/dev/null; then
    useradd --create-home --shell "$shell_name" "$user_name"
  fi
}

reset_p0() {
  prepare_home_directory P0
  printf '%s\n' 'P0 reset complete. observation.env is intentionally absent.'
}

reset_m1() {
  prepare_home_directory M1
  install -d -o "$student_user" -g "$student_group" -m 0750 "$workspace/m1/inbox"
  cp -a /opt/jdu-lab/fixtures/m1/source/. "$workspace/m1/inbox/"
  install -d -o "$student_user" -g "$student_group" -m 0750 "$workspace/m1/case01/staging"
  printf '%s\n' 'temporary configuration copy' > "$workspace/m1/case01/staging/app.conf.tmp"
  printf '%s\n' 'temporary log copy' > "$workspace/m1/case01/staging/incident.log.tmp"
  chown -R "$student_user:$student_group" "$workspace/m1"
  chmod -R u+rwX,go-rwx "$workspace/m1"
  printf '%s\n' 'M1 reset complete. case01 is incomplete and contains temporary files.'
}

reset_m2() {
  prepare_home_directory M2
  getent group ops >/dev/null || groupadd ops
  ensure_account jduops /bin/bash
  ensure_account jduviewer /bin/bash
  gpasswd -d jduops ops >/dev/null 2>&1 || true
  usermod -aG ops jduviewer
  install -d -o root -g root -m 0755 /srv/jdu-share
  find /srv/jdu-share -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
  printf '%s\n' 'This file must remain readable to the viewer.' > /srv/jdu-share/README.txt
  chown root:root /srv/jdu-share/README.txt
  chmod 0600 /srv/jdu-share/README.txt
  printf '%s\n' 'M2 reset complete. jduviewer is intentionally in ops; jduops membership and file permissions are unfinished.'
}

stop_m3_workers() {
  local unit
  for unit in \
    jdu-m3-process1.service jdu-m3-process2.service jdu-m3-process3.service \
    jdu-m3-target.service jdu-m3-decoy-a.service jdu-m3-decoy-b.service; do
    systemctl stop "$unit" >/dev/null 2>&1 || true
    systemctl reset-failed "$unit" >/dev/null 2>&1 || true
  done
}

reset_m3() {
  local process_number unit pid
  prepare_home_directory M3
  ensure_account jduworker
  if dpkg-query -W -f='${Status}' cmatrix 2>/dev/null | grep -Fxq 'install ok installed'; then
    DEBIAN_FRONTEND=noninteractive apt-get remove -y -qq cmatrix >/dev/null
  fi
  stop_m3_workers
  rm -rf -- /run/jdu-lab/m3
  for process_number in 1 2 3; do
    unit="jdu-m3-process${process_number}.service"
    rm -rf -- "/etc/systemd/system/${unit}.d"
    install -o root -g root -m 0644 "/opt/jdu-lab/fixtures/m3/$unit" "/etc/systemd/system/$unit"
  done
  systemctl daemon-reload
  for process_number in 1 2 3; do
    systemctl start "jdu-m3-process${process_number}.service"
  done
  sleep 1
  for process_number in 1 2 3; do
    unit="jdu-m3-process${process_number}.service"
    pid="$(systemctl show -p MainPID --value "$unit" 2>/dev/null || true)"
    if ! systemctl is-active --quiet "$unit" || [[ ! "$pid" =~ ^[1-9][0-9]*$ ]]; then
      systemctl status --no-pager "$unit" >&2 || true
      printf 'ERROR M3 reset could not start process%s.\n' "$process_number" >&2
      exit 1
    fi
  done
  printf '%s\n' 'M3 reset complete.' 'process1: active' 'process2: active' 'process3: active' 'cmatrix: intentionally absent'
}

restore_status_unit() {
  install -o root -g root -m 0644 /opt/jdu-lab/fixtures/m4/jdu-status.service /etc/systemd/system/jdu-status.service
  rm -rf -- /etc/systemd/system/jdu-status.service.d
  systemctl daemon-reload
}

reset_m4() {
  prepare_home_directory M4
  systemctl disable --now jdu-status.service >/dev/null 2>&1 || true
  restore_status_unit
  printf '%s\n' 'M4 reset complete. jdu-status.service is loaded, inactive, and disabled.'
}

reset_m5() {
  prepare_home_directory M5
  ensure_account jduweb
  systemctl disable --now jdu-web.service >/dev/null 2>&1 || true
  install -d -o root -g root -m 0755 /srv/jdu-web
  cp /etc/jdu-lab/web-marker /srv/jdu-web/index.txt
  chown root:root /srv/jdu-web/index.txt
  chmod 0644 /srv/jdu-web/index.txt
  install -o root -g root -m 0644 /opt/jdu-lab/fixtures/m5/jdu-web.service /etc/systemd/system/jdu-web.service
  rm -rf -- /etc/systemd/system/jdu-web.service.d
  systemctl daemon-reload
  printf '%s\n' 'M5 reset complete. jdu-web.service is loaded, inactive, and disabled; no student request exists.'
}

reset_m6() {
  prepare_home_directory M6
  rm -f -- "$workspace/m6/remote-success.env" "$workspace/m6/probes.env" \
    "$workspace/m6/unexpected-success" "$workspace/m6/unexpected-success-check" \
    "$workspace/m6/upload.txt" "$workspace/m6/remote-result.txt"
  systemctl enable --now ssh.service >/dev/null
  printf '%s\n' 'M6 reset complete. SSH remains available; the transferred file and remote-command result are intentionally absent.'
}

reset_m7() {
  prepare_home_directory M7
  getent group finalops >/dev/null || groupadd finalops
  ensure_account jdufinal
  ensure_account jduwriter /bin/bash
  ensure_account jduviewer /bin/bash
  usermod -aG finalops jdufinal
  gpasswd -d jduwriter finalops >/dev/null 2>&1 || true
  gpasswd -d jduviewer finalops >/dev/null 2>&1 || true
  systemctl disable --now jdu-final.service >/dev/null 2>&1 || true
  rm -rf -- /etc/systemd/system/jdu-final.service.d /srv/jdu-final
  install -o root -g root -m 0644 /opt/jdu-lab/fixtures/m7/jdu-final.service /etc/systemd/system/jdu-final.service
  systemctl daemon-reload
  printf '%s\n' 'M7 reset complete. The teacher unit is loaded, inactive, and disabled; content, writer membership, and permissions are intentionally unfinished.'
}

reset_p1() {
  prepare_home_directory P1
  install -d -o "$student_user" -g "$student_group" -m 0750 "$workspace/p1/inbox"
  cp -a /opt/jdu-lab/fixtures/p1/source/. "$workspace/p1/inbox/"
  install -d -o "$student_user" -g "$student_group" -m 0750 "$workspace/p1/practice01/staging"
  printf '%s\n' 'temporary guided configuration copy' > "$workspace/p1/practice01/staging/training.conf.tmp"
  printf '%s\n' 'temporary guided log copy' > "$workspace/p1/practice01/staging/practice.log.tmp"
  chown -R "$student_user:$student_group" "$workspace/p1"
  chmod -R u+rwX,go-rwx "$workspace/p1"
  printf '%s\n' 'P1 reset complete. practice01 is incomplete and contains temporary files.'
}

reset_p2() {
  prepare_home_directory P2
  getent group practiceops >/dev/null || groupadd practiceops
  ensure_account jdupracticewriter /bin/bash
  ensure_account jdupracticeviewer /bin/bash
  gpasswd -d jdupracticewriter practiceops >/dev/null 2>&1 || true
  usermod -aG practiceops jdupracticeviewer
  install -d -o root -g root -m 0755 /srv/jdu-practice-share
  find /srv/jdu-practice-share -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
  printf '%s\n' 'This guided file must remain readable to the viewer.' > /srv/jdu-practice-share/GUIDE.txt
  chown root:root /srv/jdu-practice-share/GUIDE.txt
  chmod 0600 /srv/jdu-practice-share/GUIDE.txt
  printf '%s\n' 'P2 reset complete. The viewer is intentionally in practiceops; writer membership and permissions are unfinished.'
}

stop_p3_workers() {
  local process_number
  for process_number in 1 2 3; do
    systemctl stop "jdu-p3-process${process_number}.service" >/dev/null 2>&1 || true
    systemctl reset-failed "jdu-p3-process${process_number}.service" >/dev/null 2>&1 || true
  done
}

reset_p3() {
  local process_number unit pid
  prepare_home_directory P3
  ensure_account jdupracticeworker
  if dpkg-query -W -f='${Status}' figlet 2>/dev/null | grep -Fxq 'install ok installed'; then
    DEBIAN_FRONTEND=noninteractive apt-get remove -y -qq figlet >/dev/null
  fi
  stop_p3_workers
  for process_number in 1 2 3; do
    unit="jdu-p3-process${process_number}.service"
    rm -rf -- "/etc/systemd/system/${unit}.d"
    install -o root -g root -m 0644 "/opt/jdu-lab/fixtures/p3/$unit" "/etc/systemd/system/$unit"
  done
  systemctl daemon-reload
  for process_number in 1 2 3; do
    systemctl start "jdu-p3-process${process_number}.service"
  done
  sleep 1
  for process_number in 1 2 3; do
    unit="jdu-p3-process${process_number}.service"
    pid="$(systemctl show -p MainPID --value "$unit" 2>/dev/null || true)"
    if ! systemctl is-active --quiet "$unit" || [[ ! "$pid" =~ ^[1-9][0-9]*$ ]]; then
      systemctl status --no-pager "$unit" >&2 || true
      printf 'ERROR P3 reset could not start process%s.\n' "$process_number" >&2
      exit 1
    fi
  done
  printf '%s\n' 'P3 reset complete.' 'process1: active' 'process2: active' 'process3: active' 'figlet: intentionally absent'
}

restore_practice_status_unit() {
  install -o root -g root -m 0644 /opt/jdu-lab/fixtures/p4/jdu-practice-status.service /etc/systemd/system/jdu-practice-status.service
  rm -rf -- /etc/systemd/system/jdu-practice-status.service.d
  systemctl daemon-reload
}

reset_p4() {
  prepare_home_directory P4
  systemctl disable --now jdu-practice-status.service >/dev/null 2>&1 || true
  install -d -o root -g root -m 0755 /srv/jdu-practice-status
  cp /etc/jdu-lab/practice-status-marker /srv/jdu-practice-status/index.txt
  chown root:root /srv/jdu-practice-status/index.txt
  chmod 0644 /srv/jdu-practice-status/index.txt
  restore_practice_status_unit
  printf '%s\n' 'P4 reset complete. jdu-practice-status.service is loaded, inactive, and disabled.'
}

reset_p5() {
  prepare_home_directory P5
  ensure_account jdupracticeweb
  systemctl disable --now jdu-practice-web.service >/dev/null 2>&1 || true
  install -d -o root -g root -m 0755 /srv/jdu-practice-web
  cp /etc/jdu-lab/practice-web-marker /srv/jdu-practice-web/index.txt
  chown root:root /srv/jdu-practice-web/index.txt
  chmod 0644 /srv/jdu-practice-web/index.txt
  install -o root -g root -m 0644 /opt/jdu-lab/fixtures/p5/jdu-practice-web.service /etc/systemd/system/jdu-practice-web.service
  rm -rf -- /etc/systemd/system/jdu-practice-web.service.d
  systemctl daemon-reload
  printf '%s\n' 'P5 reset complete. jdu-practice-web.service is loaded, inactive, and disabled.'
}

reset_p6() {
  prepare_home_directory P6
  rm -f -- "$workspace/p6/practice-upload.txt" "$workspace/p6/practice-remote-result.txt"
  systemctl enable --now ssh.service >/dev/null
  printf '%s\n' 'P6 reset complete. SSH remains available; guided transfer files are absent.'
}

case "$mission" in
  P1) reset_p1 ;;
  P2) reset_p2 ;;
  P3) reset_p3 ;;
  P4) reset_p4 ;;
  P5) reset_p5 ;;
  P6) reset_p6 ;;
  P0) reset_p0 ;;
  M1) reset_m1 ;;
  M2) reset_m2 ;;
  M3) reset_m3 ;;
  M4) reset_m4 ;;
  M5) reset_m5 ;;
  M6) reset_m6 ;;
  M7) reset_m7 ;;
  ALL) reset_p1; reset_p2; reset_p3; reset_p4; reset_p5; reset_p6; reset_p0; reset_m1; reset_m2; reset_m3; reset_m4; reset_m5; reset_m6; reset_m7 ;;
  *) printf 'ERROR Unknown Mission: %s\n' "$mission" >&2; usage >&2; exit 2 ;;
esac
